{
  "name": "ojs-nutrition",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm --parallel \"/^dev:.*/\"",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --filter web build && pnpm --filter admin build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm run lint:web && pnpm run lint:admin && pnpm run lint:api",
    "lint:web": "pnpm --filter web lint",
    "lint:admin": "pnpm --filter admin lint",
    "lint:api": "pnpm --filter api run lint:check",
    "typecheck": "pnpm run typecheck:web && pnpm run typecheck:admin",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck:admin": "pnpm --filter admin typecheck",
    "test": "pnpm run test:web && pnpm run test:api && pnpm run test:admin",
    "test:all": "pnpm run test",
    "test:web": "pnpm --filter web test",
    "test:web:watch": "pnpm --filter web test:watch",
    "test:web:coverage": "pnpm --filter web test:coverage",
    "test:admin": "pnpm --filter admin test",
    "test:admin:watch": "pnpm --filter admin test:watch",
    "test:admin:coverage": "pnpm --filter admin test:coverage",
    "test:api": "pnpm --filter api test",
    "test:api:watch": "pnpm --filter api test:watch",
    "test:api:coverage": "pnpm --filter api test:cov",
    "test:coverage": "pnpm run test:web:coverage && pnpm run test:api:coverage && pnpm run test:admin:coverage"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  }
}
